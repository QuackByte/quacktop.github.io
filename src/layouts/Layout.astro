---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Quacktop — Your agents. A glance away.', description = 'A native Mac companion for Claude Code and Codex. Keep agent activity, usage, and replies in your notch. Coming soon to the Mac App Store.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}/><link rel="icon" type="image/png" href={`${base}/icon.png`}/><meta name="theme-color" content="#f6f7f9"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/></head><body><a class="skip" href="#main">Skip to content</a><header class="nav wrap"><a class="brand" href={`${base}/`}><img src={`${base}/icon.png`} width="36" height="36" alt=""/>Quacktop</a><nav aria-label="Main navigation"><a href={`${base}/#features`}>Features</a><a href={`${base}/privacy/`}>Privacy</a><a class="nav-contact" href="mailto:info@quackbyte.dev">Get in touch <span aria-hidden="true">↗</span></a></nav></header><slot/><footer class="wrap"><a class="brand" href="https://quackbyte.dev">Made by Quackbyte <span aria-hidden="true">↗</span></a><div><a href={`${base}/privacy/`}>Privacy policy</a><a href="mailto:info@quackbyte.dev">Support</a><span>© {new Date().getFullYear()} Quackbyte</span></div></footer></body></html>
